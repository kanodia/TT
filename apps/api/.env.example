DATABASE_URL="postgresql://postgres@localhost:5432/twiggytomato"
JWT_SECRET="dev-only-change-me"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# In development the OTP is returned in the API response and 123456 always works.
NODE_ENV="development"

# Shared with the web server so its server-side fetches skip the per-IP rate limit.
INTERNAL_API_KEY="dev-internal-key"
# Set to 1 behind a load balancer so rate limits use the real client IP.
TRUST_PROXY=0

# ---- Optional services (see README) ----
# SMS_PROVIDER=msg91            # msg91 | twilio | log (default)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SES_FROM=alerts@example.com
# AWS_REGION=ap-south-1
# S3_BUCKET=
# S3_PRIVATE_BUCKET=
# MEDIA_BASE_URL=https://cdn.example.com
# CLAMAV_HOST=localhost:3310
# MAPBOX_TOKEN=
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# ANTHROPIC_API_KEY=
# WEB_PUBLIC_URL=https://example.in
# WORKER=off                    # run background jobs in a separate process
# SENTRY_DSN=                # error tracking; off when unset
