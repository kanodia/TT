{
  "name": "@twiggytomato/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "test:api": "dotenv -e .env.test -- prisma migrate deploy && tsx --env-file=.env.test prisma/seed.ts && tsx --env-file=.env.test --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/client-sesv2": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
