NEXT_PUBLIC_API_URL=http://localhost:4000
# Must match the API's INTERNAL_API_KEY (server-side only, never exposed to browsers).
INTERNAL_API_KEY=dev-internal-key
# Error tracking (optional)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Staging only
# STAGING_PASSWORD=            # password gate for the whole site
# NEXT_PUBLIC_DEV_OTP_KEY=     # same value as the API's DEV_OTP_KEY
